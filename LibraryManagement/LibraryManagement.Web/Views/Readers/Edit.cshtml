@* UC06 bước 3a *@
@model LibraryManagement.Web.ViewModels.Readers.ReaderFormVM

<div class="content-card" style="max-width: 760px;">
    <p class="text-muted">Mã thẻ: <strong>@Model.CardNumber</strong>. Mã thẻ, ngày cấp và hạn thẻ không sửa ở đây.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="CardNumber" />
        <partial name="_ReaderForm" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Lưu</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
