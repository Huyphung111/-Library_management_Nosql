@model LibraryManagement.Web.ViewModels.Categories.CategoryFormVM
@{
    ViewData["Title"] = "Thêm thể loại";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="content-card">
            <h2><i class="bi bi-tag-fill me-2 text-primary"></i>Thông tin thể loại mới</h2>

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Công nghệ thông tin, Lịch sử..." autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt về thể loại sách này..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Lưu thể loại
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

