@model List<LibraryManagement.Web.ViewModels.Categories.CategoryListVM>
@{
    ViewData["Title"] = "Quản lý thể loại";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm thể loại
    </a>
}

<div class="content-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <p>Chưa có thể loại nào trong danh mục.</p>
            <a asp-action="Create" class="btn btn-outline-primary btn-sm">Thêm thể loại đầu tiên</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 28%;">Tên thể loại</th>
                        <th>Mô tả</th>
                        <th style="width: 15%;" class="text-center">Số sách</th>
                        <th style="width: 15%;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td class="text-center">
                                <span>@item.BookCount sách</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa thể loại &quot;@item.Name&quot; không?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa thể loại">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

