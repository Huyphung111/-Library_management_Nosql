@* UC01. Layout tự hiện khung trắng + logo khi chưa đăng nhập, view chỉ có phần form.
   Lỗi hiện thành chữ đỏ ngay dưới ô nhập (dấu "*" thêm bằng CSS .auth-card .field-validation-error), không dùng khung đỏ. *@
@model LibraryManagement.Web.ViewModels.Account.LoginVM
@{
    // Lỗi chung của form (sai tài khoản / mật khẩu, bước 4a): hiện dưới ô Mật khẩu
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập" autofocus autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" placeholder="Mật khẩu" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
        @if (!string.IsNullOrEmpty(formError))
        {
            <div><span class="text-danger small field-validation-error">@formError</span></div>
        }
    </div>

    <button type="submit" class="btn btn-primary w-100">
        Đăng nhập
    </button>

    <p class="text-center text-muted small mt-3 mb-0">Chưa có tài khoản? Liên hệ thủ thư để được cấp.</p>
    <p class="text-center small mt-2 mb-0">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Về trang chủ</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
