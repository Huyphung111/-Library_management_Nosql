@model LibraryManagement.Web.ViewModels.Reports.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

@section PageActions {
    <a asp-controller="Loans" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-journal-plus"></i> Lập phiếu mượn
    </a>
    <a asp-controller="Loans" asp-action="Return" class="btn btn-outline-primary">
        <i class="bi bi-journal-arrow-down"></i> Nhận trả sách
    </a>
}

@* 4 thẻ số liệu tổng quan *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="bi bi-book"></i>
            </div>
            <div>
                <div class="stat-value">@Model.TotalBookTitles <span class="fs-6 fw-normal text-muted">/ @Model.TotalBookCopies cuốn</span></div>
                <div class="stat-label">Đầu sách trong thư viện</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="stat-value">@Model.ActiveReaders</div>
                <div class="stat-label">Độc giả đang hoạt động</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon accent">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <div class="stat-value">@Model.BorrowingLoans</div>
                <div class="stat-label">Phiếu đang mượn</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon danger">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="stat-value text-danger">@Model.OverdueLoans</div>
                <div class="stat-label">Phiếu mượn quá hạn</div>
            </div>
        </div>
    </div>
</div>

@* Khung việc cần xử lý *@
<div class="content-card">
    <h2><i class="bi bi-list-check me-2 text-primary"></i>Việc cần xử lý</h2>

    <div class="list-group list-group-flush">
        <a asp-controller="Renewals" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <i class="bi bi-calendar-plus text-primary me-2"></i>
                <strong>Yêu cầu gia hạn online</strong>
                <div class="text-muted small">Các phiếu mượn do độc giả gửi yêu cầu xin gia hạn thêm ngày</div>
            </div>
            @* Số bằng 0 vẫn ghi rõ loại việc ("0 chờ duyệt"), tránh hiểu là hệ thống không có yêu cầu nào *@
            <span class="@(Model.PendingRenewals > 0 ? "text-warning-emphasis fw-semibold" : "text-muted")">@Model.PendingRenewals chờ duyệt</span>
        </a>

        <a asp-controller="Reservations" asp-action="Index" asp-route-tab="pending" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <i class="bi bi-bookmark-star text-primary me-2"></i>
                <strong>Yêu cầu đặt trước sách</strong>
                <div class="text-muted small">Độc giả đăng ký chờ khi sách trong thư viện đang hết, cần duyệt hoặc từ chối</div>
            </div>
            <span class="@(Model.PendingReservations > 0 ? "text-warning-emphasis fw-semibold" : "text-muted")">@Model.PendingReservations chờ duyệt</span>
        </a>

        <a asp-controller="Reservations" asp-action="Index" asp-route-tab="held" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <i class="bi bi-bookmark-check text-primary me-2"></i>
                <strong>Sách đang giữ chờ độc giả nhận</strong>
                <div class="text-muted small">Độc giả đặt giữ online, thư viện đã để riêng sách; khi độc giả đến quầy thì lập phiếu mượn</div>
            </div>
            <span class="text-end">
                <span class="@(Model.HeldReservations > 0 ? "text-info-emphasis fw-semibold" : "text-muted")">@Model.HeldReservations đang giữ</span>
                @if (Model.HeldExpiringToday > 0)
                {
                    <span class="d-block small text-danger">@Model.HeldExpiringToday cuốn hết hạn nhận hôm nay</span>
                }
            </span>
        </a>

        <a asp-controller="Reservations" asp-action="Index" asp-route-tab="ready" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
            <div>
                <i class="bi bi-telephone-outbound text-success me-2"></i>
                <strong>Sách đặt trước đã về kho</strong>
                <div class="text-muted small">Yêu cầu đã duyệt và sách đã có sẵn, cần liên hệ độc giả đến mượn</div>
            </div>
            <span class="@(Model.ReadyReservations > 0 ? "text-success fw-semibold" : "text-muted")">@Model.ReadyReservations cần liên hệ</span>
        </a>
    </div>
</div>

