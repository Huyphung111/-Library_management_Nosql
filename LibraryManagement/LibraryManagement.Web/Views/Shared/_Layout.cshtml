@* Layout dùng chung cho cả hai vai trò (mục 6.5 thiết kế kỹ thuật).
   Đã đăng nhập: sidebar + thanh trên + nội dung. Chưa đăng nhập: một khung trắng giữa nền navy. *@
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isLibrarian = User.IsInRole(nameof(Role.Librarian));
    var isReader = isAuthenticated && !isLibrarian;
    var cardNotice = User.FindFirst("CardNotice")?.Value;

    // Nút tên người dùng + menu Đổi mật khẩu / Đăng xuất (thanh trên của Thủ thư và header của Độc giả)
    async Task UserMenu(string buttonClass)
    {
        <div class="dropdown ms-auto">
            <button class="@buttonClass dropdown-toggle topbar-user" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="topbar-name">@User.Identity!.Name</span>
                <span class="topbar-role">@(isLibrarian ? "Thủ thư" : "Độc giả")</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                        <i class="bi bi-key"></i> Đổi mật khẩu
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAuthenticated ? "app-body" : "auth-body") @(isReader ? "reader-body" : "")">
@if (isAuthenticated)
{
    @if (isReader)
    {
        @* Độc giả: header ngang toàn màn hình theo thiết kế Antigravity (logo HUIT, ô tìm kiếm), menu bên trái nằm dưới header.
           Ô tìm kiếm gửi GET /Catalog?search=...; ở trang chủ độc giả, partial _BookShowcase bắt form này để lọc ngay trên trang. *@
        <header class="reader-header">
            <button class="reader-toggle" type="button" data-sidebar-toggle aria-controls="sidebar" aria-label="Thu gọn / mở menu">
                <i class="bi bi-list"></i>
            </button>
            <a class="reader-brand" asp-controller="Catalog" asp-action="Index">
                <img src="~/images/huit-logo.jpg" alt="Logo HUIT" class="reader-brand-logo" />
                <div>
                    <div class="reader-brand-title">THƯ VIỆN HUIT</div>
                    <div class="reader-brand-sub">Hệ thống quản lý mượn trả sách</div>
                </div>
            </a>
            <form class="reader-header-search" id="searchForm" role="search" method="get" asp-controller="Catalog" asp-action="Index">
                <input type="text" id="searchInput" name="search" placeholder="Tìm theo tên sách hoặc tác giả..." autocomplete="off" />
                <button type="submit"><i class="bi bi-search"></i> Tìm</button>
            </form>
            @{ await UserMenu("reader-user"); }
        </header>
    }

    <aside id="sidebar" class="sidebar">
        @if (!isReader)
        {
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half"></i>
                <span>THƯ VIỆN</span>
            </a>
        }
        @if (isLibrarian)
        {
            <partial name="_LibrarianMenu" />
        }
        else
        {
            <partial name="_ReaderMenu" />
        }
    </aside>
    <div class="sidebar-backdrop" data-sidebar-toggle></div>

    <div class="app-main">
        @if (!isReader)
        {
            <header class="topbar">
                <button class="btn btn-light btn-sm topbar-toggle" type="button" data-sidebar-toggle
                        aria-controls="sidebar" aria-label="Thu gọn / mở menu">
                    <i class="bi bi-list"></i>
                </button>
                @{ await UserMenu("btn btn-light btn-sm"); }
            </header>
        }

        @if (!string.IsNullOrEmpty(cardNotice))
        {
            @* UC01 bước 5a: thẻ bị khóa hoặc hết hạn, chỉ được xem thông tin *@
            <div class="card-notice" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@cardNotice</span>
            </div>
        }

        <main role="main" class="app-content">
            <partial name="_Alert" />

            <div class="page-header">
                <h1 class="page-title">@ViewData["Title"]</h1>
                @if (IsSectionDefined("PageActions"))
                {
                    <div class="page-actions">@RenderSection("PageActions")</div>
                }
            </div>

            @RenderBody()
        </main>
    </div>
}
else
{
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <img src="~/images/huit-logo.jpg" alt="Logo HUIT" class="auth-brand-logo" />
                <div>
                    <div class="auth-brand-name">THƯ VIỆN HUIT</div>
                    <div class="auth-brand-sub">Hệ thống quản lý mượn trả sách</div>
                </div>
            </div>
            <partial name="_Alert" />
            @RenderBody()
        </div>
    </main>
    if (IsSectionDefined("PageActions"))
    {
        IgnoreSection("PageActions");
    }
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
