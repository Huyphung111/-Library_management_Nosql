@* Menu Thủ thư: Dashboard ở trên cùng, các mục còn lại gom thành nhóm xổ xuống (Bootstrap collapse) có mũi tên.
   Nhóm chứa trang đang mở thì mở sẵn. Mục đang mở được tô sáng khi khớp controller, và khớp cả action / type nếu có truyền vào. *@
@{
    var route = ViewContext.RouteData.Values;
    var currentController = route["controller"]?.ToString();
    var currentAction = route["action"]?.ToString();
    var currentType = Context.Request.Query["type"].ToString();

    string Active(string controller, string? action = null, string? type = null)
    {
        var match = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            && (type == null || string.Equals(currentType, type, StringComparison.OrdinalIgnoreCase));
        return match ? "active" : "";
    }

    bool InGroup(params string[] controllers) =>
        controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase));

    // Trong LoansController, mọi action trừ Return thuộc mục "Lập phiếu mượn"
    var onReturn = string.Equals(currentController, "Loans", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Return", StringComparison.OrdinalIgnoreCase);

    // Trang tra cứu (UC11, SearchController) không còn nhóm riêng: tab Phiếu mượn thuộc "Mượn trả",
    // tab Sách / Độc giả tô sáng mục Sách / Độc giả trong "Danh mục" (các trang đó đã có ô tìm kiếm riêng).
    var onSearch = InGroup("Search");
    var searchType = string.IsNullOrEmpty(currentType) ? "book" : currentType.ToLowerInvariant();   // SearchController mặc định "book"
    var searchLoan = onSearch && searchType == "loan";
    var searchReader = onSearch && searchType == "reader";
    var searchBook = onSearch && !searchLoan && !searchReader;

    var openLoans = InGroup("Loans", "Renewals", "Reservations") || searchLoan;
    var openCatalog = InGroup("Books", "Categories", "Readers") || searchBook || searchReader;
    var openReports = InGroup("Reports");

    // Nút tiêu đề nhóm: icon + tên + mũi tên, bấm để xổ / thu danh sách bên dưới
    void GroupToggle(string id, string icon, string title, bool open)
    {
        <button class="nav-group-toggle @(open ? "" : "collapsed")" type="button"
                data-bs-toggle="collapse" data-bs-target="#@id" aria-expanded="@(open ? "true" : "false")" aria-controls="@id">
            <i class="bi @icon"></i>
            <span>@title</span>
            <i class="bi bi-chevron-down nav-caret"></i>
        </button>
    }
}
<nav class="sidebar-nav">
    <a class="nav-link nav-top @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-speedometer2"></i> Dashboard
    </a>

    @{ GroupToggle("nav-loans", "bi-arrow-left-right", "Mượn trả", openLoans); }
    <div class="collapse nav-group @(openLoans ? "show" : "")" id="nav-loans">
        <a class="nav-link @(onReturn ? "" : Active("Loans"))" asp-controller="Loans" asp-action="Create">
            <i class="bi bi-journal-plus"></i> Lập phiếu mượn
        </a>
        <a class="nav-link @Active("Loans", "Return")" asp-controller="Loans" asp-action="Return">
            <i class="bi bi-journal-arrow-down"></i> Nhận trả sách
        </a>
        <a class="nav-link @Active("Renewals")" asp-controller="Renewals" asp-action="Index">
            <i class="bi bi-calendar-plus"></i> Gia hạn
        </a>
        <a class="nav-link @Active("Reservations")" asp-controller="Reservations" asp-action="Index">
            <i class="bi bi-bookmark-star"></i> Đặt trước
        </a>
        <a class="nav-link @(searchLoan ? "active" : "")" asp-controller="Search" asp-action="Index" asp-route-type="loan">
            <i class="bi bi-receipt"></i> Tra cứu phiếu mượn
        </a>
    </div>

    @{ GroupToggle("nav-catalog", "bi-collection", "Danh mục", openCatalog); }
    <div class="collapse nav-group @(openCatalog ? "show" : "")" id="nav-catalog">
        <a class="nav-link @(searchBook ? "active" : Active("Books"))" asp-controller="Books" asp-action="Index">
            <i class="bi bi-book"></i> Sách
        </a>
        <a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index">
            <i class="bi bi-tags"></i> Thể loại
        </a>
        <a class="nav-link @(searchReader ? "active" : Active("Readers"))" asp-controller="Readers" asp-action="Index">
            <i class="bi bi-people"></i> Độc giả
        </a>
    </div>

    @{ GroupToggle("nav-reports", "bi-bar-chart-line", "Thống kê", openReports); }
    <div class="collapse nav-group @(openReports ? "show" : "")" id="nav-reports">
        <a class="nav-link @Active("Reports", "TopBooks")" asp-controller="Reports" asp-action="TopBooks">
            <i class="bi bi-trophy"></i> Sách mượn nhiều
        </a>
        <a class="nav-link @Active("Reports", "Overdue")" asp-controller="Reports" asp-action="Overdue">
            <i class="bi bi-alarm"></i> Phiếu quá hạn
        </a>
        <a class="nav-link @Active("Reports", "ByMonth")" asp-controller="Reports" asp-action="ByMonth">
            <i class="bi bi-calendar3"></i> Lượt mượn theo tháng
        </a>
        <a class="nav-link @Active("Reports", "ByCategory")" asp-controller="Reports" asp-action="ByCategory">
            <i class="bi bi-pie-chart"></i> Lượt mượn theo thể loại
        </a>
        <a class="nav-link @Active("Reports", "Fines")" asp-controller="Reports" asp-action="Fines">
            <i class="bi bi-cash-coin"></i> Tiền phạt
        </a>
    </div>
</nav>
