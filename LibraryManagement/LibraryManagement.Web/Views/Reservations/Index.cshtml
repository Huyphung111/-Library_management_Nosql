@model LibraryManagement.Web.ViewModels.Reservations.LibrarianReservationListVM
@using LibraryManagement.Web.Models
@using LibraryManagement.Web.Services
@{
    ViewData["Title"] = "Xử lý đặt trước";
}

<div class="content-card">
    @* Thanh tabs điều hướng: thiết kế phẳng, thanh lịch, màu sắc trung tính trang nhã *@
    <ul class="nav nav-pills mb-3 border-bottom pb-3 gap-1">
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "all" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="all">
                Tất cả <span class="badge rounded-pill @(Model.CurrentTab == "all" ? "bg-white text-primary" : "bg-light text-secondary border") ms-1">@Model.TotalCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "pending" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="pending">
                Chờ duyệt
                <span class="badge rounded-pill @(Model.CurrentTab == "pending" ? "bg-white text-primary" : (Model.PendingCount > 0 ? "bg-warning text-dark" : "bg-light text-secondary border")) ms-1">@Model.PendingCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "ready" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="ready">
                Sách đã về kho
                <span class="badge rounded-pill @(Model.CurrentTab == "ready" ? "bg-white text-primary" : (Model.ReadyCount > 0 ? "bg-success text-white" : "bg-light text-secondary border")) ms-1">@Model.ReadyCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "held" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="held">
                Đang giữ sách
                <span class="badge rounded-pill @(Model.CurrentTab == "held" ? "bg-white text-primary" : (Model.HeldCount > 0 ? "bg-info text-dark" : "bg-light text-secondary border")) ms-1">@Model.HeldCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "approved" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="approved">
                Đã duyệt <span class="badge rounded-pill @(Model.CurrentTab == "approved" ? "bg-white text-primary" : "bg-light text-secondary border") ms-1">@Model.ApprovedCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "completed" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="completed">
                Hoàn tất <span class="badge rounded-pill @(Model.CurrentTab == "completed" ? "bg-white text-primary" : "bg-light text-secondary border") ms-1">@Model.CompletedCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "cancelled" ? "active" : "text-dark")" asp-action="Index" asp-route-tab="cancelled">
                Từ chối / Đã hủy / Hết hạn <span class="badge rounded-pill @(Model.CurrentTab == "cancelled" ? "bg-white text-primary" : "bg-light text-secondary border") ms-1">@Model.CancelledCount</span>
            </a>
        </li>
    </ul>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
            <p class="fs-6 text-muted mt-2 mb-0">Không có yêu cầu đặt trước nào trong mục này.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 45px;">#</th>
                        <th>Độc giả & Liên hệ</th>
                        <th>Cuốn sách</th>
                        <th style="width: 130px;">Tồn kho</th>
                        <th style="width: 140px;">Ngày đăng ký</th>
                        <th style="width: 120px;">Trạng thái</th>
                        <th>Ghi chú</th>
                        <th class="actions" style="width: 190px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td class="text-muted">@(i + 1)</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.ReaderName</div>
                                <div class="text-muted small">
                                    <span>@item.CardNumber</span>
                                    @* Chỉ hiện cảnh báo khi thẻ BỊ KHÓA hoặc HẾT HẠN *@
                                    @if (item.CardStatus == CardStatus.Locked)
                                    {
                                        <span class="badge status-locked ms-1"><i class="bi bi-lock-fill me-1"></i>Thẻ bị khóa</span>
                                    }
                                    else if (item.IsCardExpired)
                                    {
                                        <span class="badge status-expired ms-1"><i class="bi bi-calendar-x me-1"></i>Thẻ hết hạn</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.ReaderPhone) || !string.IsNullOrEmpty(item.ReaderEmail))
                                {
                                    <div class="small text-muted mt-1">
                                        @if (!string.IsNullOrEmpty(item.ReaderPhone))
                                        {
                                            <span class="me-2"><i class="bi bi-telephone me-1"></i>@item.ReaderPhone</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.ReaderEmail))
                                        {
                                            <span><i class="bi bi-envelope me-1"></i>@item.ReaderEmail</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.BookTitle</div>
                            </td>
                            <td>
                                @if (item.AvailableQuantity > 0)
                                {
                                    <span class="badge bg-light text-dark border">
                                        Có sẵn @item.AvailableQuantity cuốn
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Hết sách (0)
                                    </span>
                                }
                            </td>
                            <td>
                                <div>@DateHelper.ToVnDate(item.ReservedAt).ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@item.ReservedAt.ToLocalTime().ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span class="badge status-@item.Status.ToString().ToLower()">
                                    @item.Status.ToVn()
                                </span>
                            </td>
                            <td>
                                @if (item.Status == ReservationStatus.Held && item.HoldUntil.HasValue)
                                {
                                    <span class="badge status-held">
                                        <i class="bi bi-bookmark-check me-1"></i>Giữ đến hết @item.HoldUntil.Value.ToVnDateText()
                                    </span>
                                }
                                @if (item.IsReadyForPickup)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-telephone-outbound me-1"></i>Sách đã về - Có thể gọi
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(item.Reason))
                                {
                                    <div class="small text-muted mt-1">@item.Reason</div>
                                }
                                @if (item.CardStatus == CardStatus.Locked || item.IsCardExpired)
                                {
                                    <div class="small text-danger mt-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Thẻ độc giả không hợp lệ
                                    </div>
                                }
                            </td>
                            <td class="actions">
                                @if (item.Status == ReservationStatus.Pending)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline" onsubmit="return confirm('Xác nhận DUYỆT yêu cầu đặt trước cho độc giả @item.ReaderName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                                        <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Duyệt yêu cầu">
                                            <i class="bi bi-check-lg me-1"></i>Duyệt
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            onclick="openRejectModal('@item.Id', '@item.ReaderName', '@item.BookTitle')" title="Từ chối">
                                        <i class="bi bi-x-lg me-1"></i>Từ chối
                                    </button>
                                }
                                else if (item.Status == ReservationStatus.Held)
                                {
                                    <a asp-controller="Loans" asp-action="Create" asp-route-cardNumber="@item.CardNumber"
                                       class="btn btn-sm btn-outline-primary me-1" title="Độc giả đến nhận: lập phiếu mượn">
                                        <i class="bi bi-journal-plus me-1"></i>Lập phiếu
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            onclick="openCancelModal('@item.Id', '@item.ReaderName', '@item.BookTitle')" title="Hủy đặt giữ, trả sách về kho">
                                        <i class="bi bi-x-circle me-1"></i>Hủy
                                    </button>
                                }
                                else if (item.Status == ReservationStatus.Approved)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            onclick="openCancelModal('@item.Id', '@item.ReaderName', '@item.BookTitle')" title="Hủy yêu cầu">
                                        <i class="bi bi-x-circle me-1"></i>Hủy
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">---</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Modal Từ chối yêu cầu *@
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rejectId" name="Id" />
                <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-x-circle me-2"></i>Từ chối yêu cầu đặt trước</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn đang từ chối yêu cầu đặt sách <strong id="rejectBook"></strong> của độc giả <strong id="rejectReader"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do từ chối: <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do từ chối (ví dụ: Thẻ hết hạn, sách ngừng lưu hành...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Hủy yêu cầu đã duyệt *@
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cancelId" name="Id" />
                <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                <div class="modal-header">
                    <h5 class="modal-title text-secondary"><i class="bi bi-exclamation-triangle me-2"></i>Hủy yêu cầu đặt trước</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Hủy yêu cầu đặt sách <strong id="cancelBook"></strong> của độc giả <strong id="cancelReader"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do hủy: <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do hủy (ví dụ: Liên hệ nhiều lần không nghe máy, độc giả không có nhu cầu...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-secondary">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(id, readerName, bookTitle) {
            document.getElementById('rejectId').value = id;
            document.getElementById('rejectReader').innerText = readerName;
            document.getElementById('rejectBook').innerText = bookTitle;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function openCancelModal(id, readerName, bookTitle) {
            document.getElementById('cancelId').value = id;
            document.getElementById('cancelReader').innerText = readerName;
            document.getElementById('cancelBook').innerText = bookTitle;
            new bootstrap.Modal(document.getElementById('cancelModal')).show();
        }
    </script>
}
