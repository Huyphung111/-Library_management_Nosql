@model LibraryManagement.Web.ViewModels.Reservations.LibrarianReservationListVM
@using LibraryManagement.Web.Models
@using LibraryManagement.Web.Services
@{
    ViewData["Title"] = "Xử lý đặt trước";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-bookmark-star me-2 text-primary"></i>Quản lý & Xử lý đặt trước</h2>
            <p class="text-muted small mb-0">Theo dõi, duyệt yêu cầu và liên hệ độc giả khi có sách trả về kho (QĐ08)</p>
        </div>
    </div>

    @* Cảnh báo sách đã về kho cần gọi độc giả *@
    @if (Model.ReadyCount > 0)
    {
        <div class="alert alert-success d-flex align-items-center mb-3 py-2 shadow-sm" role="alert">
            <i class="bi bi-telephone-outbound-fill fs-4 me-3 flex-shrink-0 text-success"></i>
            <div>
                <strong>Có @Model.ReadyCount yêu cầu đặt trước đã duyệt và sách hiện đã có trong kho!</strong><br />
                <span class="small">Vui lòng kiểm tra tab <strong>"Sách đã về kho"</strong> để lấy số điện thoại liên hệ độc giả đến nhận sách sớm nhất.</span>
            </div>
            <a asp-action="Index" asp-route-tab="ready" class="btn btn-sm btn-success ms-auto text-nowrap">
                <i class="bi bi-list-check me-1"></i>Xem danh sách gọi
            </a>
        </div>
    }

    @* Tabs phân loại *@
    <ul class="nav nav-pills mb-3 border-bottom pb-2">
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "all" ? "active" : "")" asp-action="Index" asp-route-tab="all">
                Tất cả <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "pending" ? "active" : "")" asp-action="Index" asp-route-tab="pending">
                Chờ duyệt
                @if (Model.PendingCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "ready" ? "active" : "")" asp-action="Index" asp-route-tab="ready">
                <i class="bi bi-bell-fill text-danger me-1"></i>Sách đã về kho
                @if (Model.ReadyCount > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.ReadyCount</span>
                }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "approved" ? "active" : "")" asp-action="Index" asp-route-tab="approved">
                Đã duyệt <span class="badge bg-light text-dark ms-1">@Model.ApprovedCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "completed" ? "active" : "")" asp-action="Index" asp-route-tab="completed">
                Hoàn tất <span class="badge bg-light text-dark ms-1">@Model.CompletedCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.CurrentTab == "cancelled" ? "active" : "")" asp-action="Index" asp-route-tab="cancelled">
                Từ chối / Đã hủy <span class="badge bg-light text-dark ms-1">@Model.CancelledCount</span>
            </a>
        </li>
    </ul>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="fs-5 mt-2">Không có yêu cầu đặt trước nào trong mục này.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>Độc giả & Liên hệ</th>
                        <th>Cuốn sách</th>
                        <th style="width: 140px;">Kho sách</th>
                        <th style="width: 150px;">Ngày đăng ký</th>
                        <th style="width: 130px;">Trạng thái</th>
                        <th>Ghi chú / Xử lý</th>
                        <th class="actions" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr class="@(item.IsReadyForPickup ? "table-success" : "")">
                            <td>@(i + 1)</td>
                            <td>
                                <div class="fw-bold">@item.ReaderName</div>
                                <div class="small text-muted">
                                    <span class="badge bg-light text-dark border">@item.CardNumber</span>
                                    @if (item.CardStatus == CardStatus.Locked)
                                    {
                                        <span class="badge status-locked ms-1"><i class="bi bi-lock-fill me-1"></i>Thẻ bị khóa</span>
                                    }
                                    else if (item.IsCardExpired)
                                    {
                                        <span class="badge status-expired ms-1"><i class="bi bi-calendar-x me-1"></i>Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge status-active ms-1">Thẻ hợp lệ</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.ReaderPhone) || !string.IsNullOrEmpty(item.ReaderEmail))
                                {
                                    <div class="small mt-1">
                                        @if (!string.IsNullOrEmpty(item.ReaderPhone))
                                        {
                                            <a href="tel:@item.ReaderPhone" class="text-decoration-none text-success fw-semibold me-2">
                                                <i class="bi bi-telephone-fill me-1"></i>@item.ReaderPhone
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(item.ReaderEmail))
                                        {
                                            <span class="text-muted"><i class="bi bi-envelope me-1"></i>@item.ReaderEmail</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@item.BookTitle</div>
                            </td>
                            <td>
                                @if (item.AvailableQuantity > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Có sẵn @item.AvailableQuantity cuốn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border px-2 py-1">
                                        <i class="bi bi-dash-circle me-1"></i>Hết sách (0)
                                    </span>
                                }
                            </td>
                            <td>
                                <div>@DateHelper.ToVnDate(item.ReservedAt).ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@item.ReservedAt.ToLocalTime().ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span class="badge status-@item.Status.ToString().ToLower()">
                                    @item.Status.ToVn()
                                </span>
                            </td>
                            <td>
                                @if (item.IsReadyForPickup)
                                {
                                    <div class="text-success fw-bold small">
                                        <i class="bi bi-megaphone-fill me-1"></i>Sách đã về kho! Gọi độc giả đến quầy.
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.Reason))
                                {
                                    <div class="small text-muted"><i class="bi bi-chat-left-text me-1"></i>@item.Reason</div>
                                }
                                @if (item.CardStatus == CardStatus.Locked || item.IsCardExpired)
                                {
                                    <div class="small text-danger mt-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Cảnh báo: Thẻ độc giả không hợp lệ!
                                    </div>
                                }
                            </td>
                            <td class="actions">
                                @if (item.Status == ReservationStatus.Pending)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline" onsubmit="return confirm('Xác nhận DUYỆT yêu cầu đặt trước cho độc giả @item.ReaderName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                                        <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Duyệt yêu cầu">
                                            <i class="bi bi-check-lg"></i> Duyệt
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            onclick="openRejectModal('@item.Id', '@item.ReaderName', '@item.BookTitle')" title="Từ chối">
                                        <i class="bi bi-x-lg"></i> Từ chối
                                    </button>
                                }
                                else if (item.Status == ReservationStatus.Approved)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            onclick="openCancelModal('@item.Id', '@item.ReaderName', '@item.BookTitle')" title="Hủy yêu cầu">
                                        <i class="bi bi-dash-circle"></i> Hủy
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">---</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Modal Từ chối yêu cầu *@
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rejectId" name="Id" />
                <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-x-circle me-2"></i>Từ chối yêu cầu đặt trước</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn đang từ chối yêu cầu đặt sách <strong id="rejectBook"></strong> của độc giả <strong id="rejectReader"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do từ chối: <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do từ chối (ví dụ: Thẻ hết hạn, sách ngừng lưu hành...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Hủy yêu cầu đã duyệt *@
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="cancelId" name="Id" />
                <input type="hidden" name="returnTab" value="@Model.CurrentTab" />
                <div class="modal-header">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle me-2"></i>Hủy yêu cầu đặt trước</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Hủy yêu cầu đặt sách <strong id="cancelBook"></strong> của độc giả <strong id="cancelReader"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do hủy: <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Reason" rows="3" required placeholder="Nhập lý do hủy (ví dụ: Liên hệ nhiều lần không nghe máy, độc giả không có nhu cầu...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(id, readerName, bookTitle) {
            document.getElementById('rejectId').value = id;
            document.getElementById('rejectReader').innerText = readerName;
            document.getElementById('rejectBook').innerText = bookTitle;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function openCancelModal(id, readerName, bookTitle) {
            document.getElementById('cancelId').value = id;
            document.getElementById('cancelReader').innerText = readerName;
            document.getElementById('cancelBook').innerText = bookTitle;
            new bootstrap.Modal(document.getElementById('cancelModal')).show();
        }
    </script>
}
