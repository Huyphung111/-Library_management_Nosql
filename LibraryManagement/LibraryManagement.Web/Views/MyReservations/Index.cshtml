@model List<LibraryManagement.Web.ViewModels.Reservations.MyReservationItemVM>
@using LibraryManagement.Web.Models
@using LibraryManagement.Web.Services
@{
    ViewData["Title"] = "Đặt trước của tôi";
}

@section PageActions {
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-search me-1"></i>Khám phá thêm sách
    </a>
}

<div class="content-card">
    @* Thông báo nguyên tắc hoạt động QĐ08 *@
    <div class="alert alert-info d-flex align-items-center mb-3 p-3" role="alert">
        <i class="bi bi-info-circle-fill me-2 fs-5 flex-shrink-0 text-primary"></i>
        <div style="font-size: 0.95rem;">
            <strong>Đặt giữ</strong> (sách còn trên giá): thư viện giữ sẵn 1 cuốn, bạn mang thẻ đến quầy nhận trước hạn ghi bên dưới, quá hạn sẽ tự hủy.<br />
            <strong>Đặt trước</strong> (sách đã hết): bạn vào hàng chờ, khi có sách về thư viện sẽ liên hệ độc giả đăng ký sớm nhất.
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-bookmark-x text-muted" style="font-size: 3rem;"></i>
            <p class="fs-5 mt-2">Bạn chưa có yêu cầu đặt trước cuốn sách nào.</p>
            <p class="small text-muted">Sách còn trên giá: bấm "Đặt giữ" để thư viện giữ sẵn cho bạn. Sách đã hết: bấm "Đặt trước" để được liên hệ khi có sách về.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-search me-1"></i>Khám phá danh mục sách
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Tên sách</th>
                        <th style="width: 170px;">Ngày đăng ký</th>
                        <th style="width: 150px;">Trạng thái</th>
                        <th>Ghi chú / Lý do</th>
                        <th class="actions" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.BookId" class="fw-semibold text-decoration-none">
                                    @item.BookTitle
                                </a>
                            </td>
                            <td>
                                <div><i class="bi bi-calendar3 me-1 text-muted"></i>@DateHelper.ToVnDate(item.ReservedAt).ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@item.ReservedAt.ToLocalTime().ToString("HH:mm")</small>
                            </td>
                            <td>
                                <span class="badge status-@item.Status.ToString().ToLower()">
                                    @item.Status.ToVn()
                                </span>
                            </td>
                            <td>
                                @if (item.Status == ReservationStatus.Held && item.HoldUntil.HasValue)
                                {
                                    <span class="text-success small fw-medium">
                                        Sách đã được giữ cho bạn. Mang thẻ đến quầy nhận trước hết ngày <strong>@item.HoldUntil.Value.ToVnDateText()</strong>.
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(item.Reason))
                                {
                                    <span class="text-muted small">@item.Reason</span>
                                }
                                else if (item.Status == ReservationStatus.Pending)
                                {
                                    <span class="text-muted small fst-italic">Đang đợi thủ thư kiểm tra và duyệt...</span>
                                }
                                else if (item.Status == ReservationStatus.Approved)
                                {
                                    <span class="text-success small fw-medium">Đã duyệt. Thư viện sẽ gọi khi sách về!</span>
                                }
                                else if (item.Status == ReservationStatus.Completed)
                                {
                                    <span class="text-primary small">Bạn đã mượn thành công cuốn sách này</span>
                                }
                                else
                                {
                                    <span class="text-muted small">---</span>
                                }
                            </td>
                            <td class="actions">
                                @if (item.CanCancel)
                                {
                                    <form asp-action="Cancel" method="post" onsubmit="return confirm('@(item.Status == ReservationStatus.Held ? "Hủy đặt giữ? Cuốn sách sẽ được trả lại kho cho người khác mượn." : "Bạn có chắc chắn muốn hủy yêu cầu đặt trước cuốn sách này?")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy yêu cầu">
                                            <i class="bi bi-x-circle me-1"></i>Hủy
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Không khả dụng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
