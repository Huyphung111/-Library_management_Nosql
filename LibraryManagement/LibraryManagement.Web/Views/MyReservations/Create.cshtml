@model LibraryManagement.Web.ViewModels.Reservations.ReservationConfirmVM
@{
    ViewData["Title"] = "Xác nhận đặt trước sách";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card">
            <div class="d-flex align-items-center mb-3">
                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="mb-0"><i class="bi bi-bookmark-plus text-primary me-2"></i>Đăng ký đặt trước sách</h2>
                    <small class="text-muted">Đăng ký vào danh sách chờ để thư viện liên hệ khi có sách trả về kho</small>
                </div>
            </div>

            @* Card tóm tắt sách *@
            <div class="card border-0 bg-light p-3 mb-4 rounded-3">
                <div class="d-flex">
                    <div class="me-3 fs-1 text-primary">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-primary">@Model.BookTitle</h4>
                        <div class="text-muted mb-2">
                            <i class="bi bi-person me-1"></i>Tác giả: <strong>@Model.Authors</strong>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-building me-1"></i>Nhà xuất bản: @Model.Publisher @(Model.PublishYear.HasValue ? $"({Model.PublishYear})" : "")
                        </div>
                        <div>
                            @foreach (var cat in Model.CategoryNames)
                            {
                                <span class="badge bg-secondary me-1">@cat</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Lưu ý quan trọng theo QĐ08 *@
            <div class="alert alert-warning mb-4" role="alert">
                <div class="d-flex">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3 flex-shrink-0 text-warning"></i>
                    <div>
                        <h6 class="alert-heading fw-bold mb-1">Lưu ý quan trọng về chính sách đặt trước:</h6>
                        <ul class="mb-0 ps-3 small">
                            <li>Thư viện <strong>không giữ riêng cuốn sách</strong> cho bất kỳ độc giả nào.</li>
                            <li>Khi có người trả sách về kho, thủ thư sẽ liên hệ qua số điện thoại với các độc giả trong danh sách chờ theo thứ tự ưu tiên ai đặt trước.</li>
                            <li>Độc giả nào đến quầy thư viện làm thủ tục mượn trước sẽ được mượn trước.</li>
                            <li>Yêu cầu đặt trước sẽ tự động <strong>hoàn tất</strong> ngay khi bạn làm thủ tục mượn cuốn sách này tại quầy.</li>
                        </ul>
                    </div>
                </div>
            </div>

            @* Form xác nhận *@
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.BookId" />
                <input type="hidden" name="confirmed" value="true" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">
                        <i class="bi bi-x me-1"></i>Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Xác nhận đặt trước
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
