@model LibraryManagement.Web.ViewModels.Reservations.ReservationConfirmVM
@{
    ViewData["Title"] = Model.WillHold ? "Xác nhận đặt giữ sách" : "Xác nhận đặt trước sách";
}

@section PageActions {
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card">
            @* Thông tin sách dạng phiếu thư viện chuẩn, chữ đều và dễ đọc *@
            <div class="border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-muted">@string.Join(", ", Model.CategoryNames)</span>
                    @if (Model.WillHold)
                    {
                        <span class="badge status-active">
                            <i class="bi bi-check-circle me-1"></i>Còn @Model.AvailableQuantity cuốn trên giá
                        </span>
                    }
                    else if (Model.AvailableQuantity > 0)
                    {
                        <span class="badge status-pending">
                            <i class="bi bi-people me-1"></i>Đang có độc giả xếp hàng chờ
                        </span>
                    }
                    else
                    {
                        <span class="badge status-overdue">
                            <i class="bi bi-x-circle me-1"></i>Đang hết sách trong kho
                        </span>
                    }
                </div>

                <h3 class="fw-bold text-primary mb-2">
                    @Model.BookTitle
                </h3>

                <div class="text-secondary" style="font-size: 0.95rem;">
                    <div class="mb-1">
                        <i class="bi bi-person me-2 text-primary"></i>Tác giả: <strong>@Model.Authors</strong>
                    </div>
                    <div>
                        <i class="bi bi-building me-2 text-primary"></i>Nhà xuất bản: <strong>@Model.Publisher @(Model.PublishYear.HasValue ? $"({Model.PublishYear})" : "")</strong>
                    </div>
                </div>
            </div>

            @if (Model.WillHold)
            {
                @* Chính sách đặt giữ: sách còn trên giá, thư viện giữ 1 cuốn *@
                <div class="alert alert-info d-flex align-items-start gap-3 p-3 mb-4" role="alert">
                    <i class="bi bi-bookmark-check-fill fs-5 text-primary flex-shrink-0 mt-1"></i>
                    <div style="font-size: 0.95rem;">
                        <div class="fw-bold mb-2">Chính sách đặt giữ sách:</div>
                        <ul class="mb-0 ps-3" style="line-height: 1.7;">
                            <li>Thư viện giữ riêng 1 cuốn cho bạn đến hết ngày @Model.HoldUntilPreview.ToString("dd/MM/yyyy").</li>
                            <li>Mang thẻ độc giả đến quầy trước hạn trên, Thủ thư sẽ lập phiếu mượn cho bạn.</li>
                            <li>Quá hạn không đến nhận, yêu cầu tự động hủy và sách được trả lại kho.</li>
                            <li>Mỗi độc giả được giữ tối đa @Model.MaxHolds cuốn cùng lúc. Bạn có thể tự hủy trong mục "Đặt trước của tôi".</li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                @* Chính sách đặt trước: sách hết (hoặc đã có người chờ), vào hàng chờ *@
                <div class="alert alert-warning d-flex align-items-start gap-3 p-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0 mt-1"></i>
                    <div style="font-size: 0.95rem;">
                        <div class="fw-bold mb-2">Chính sách đặt trước của thư viện (QĐ08):</div>
                        <ul class="mb-0 ps-3" style="line-height: 1.7;">
                            @if (Model.AvailableQuantity > 0)
                            {
                                <li>Cuốn sách này đang có độc giả khác <strong>xếp hàng chờ trước</strong>, yêu cầu của bạn sẽ được đưa vào hàng chờ.</li>
                            }
                            <li>Khi có sách cho bạn, thủ thư sẽ liên hệ qua điện thoại theo thứ tự đăng ký.</li>
                            <li>Độc giả nào đến quầy làm thủ tục trước sẽ được mượn trước.</li>
                            <li>Yêu cầu đặt trước sẽ tự động <strong>hoàn tất</strong> khi bạn đến quầy mượn cuốn sách này.</li>
                        </ul>
                    </div>
                </div>
            }

            @* Nút xác nhận *@
            <form asp-action="Create" method="post" class="d-flex justify-content-end gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.BookId" />
                <input type="hidden" name="confirmed" value="true" />

                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">
                    Hủy bỏ
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    @(Model.WillHold ? "Xác nhận đặt giữ" : "Xác nhận đặt trước")
                </button>
            </form>
        </div>
    </div>
</div>
