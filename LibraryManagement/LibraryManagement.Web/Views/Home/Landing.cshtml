@* Trang chủ công khai trước khi đăng nhập (thiết kế gốc: Antigravity/landing-preview.html).
   Header + footer riêng của trang khách; phần trưng bày sách dùng chung partial _BookShowcase
   (trang chủ độc giả Catalog/Index cũng dùng partial này). *@
@model LibraryManagement.Web.ViewModels.Home.BookShowcaseVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thư viện HUIT - Trang chủ tra cứu sách</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
</head>
<body>

  <!-- 1. HEADER CHÍNH -->
  <header class="pub-header">
    <div class="pub-container pub-header-inner">
      <a href="#" class="pub-brand" id="resetHome">
        <img src="~/images/huit-library-brand.jpg" alt="Đại học Công Thương TP. Hồ Chí Minh - Trung tâm Thông tin - Thư viện" class="pub-brand-img" />
      </a>

      <form class="pub-search" id="searchForm">
        <input type="text" id="searchInput" placeholder="Tìm theo tên sách hoặc tác giả..." autocomplete="off" />
        <button type="submit" aria-label="Tìm" title="Tìm"><i class="bi bi-search"></i></button>
      </form>

      <!-- Giờ mở cửa + Hotline: 2 dòng gọn giữa ô tìm kiếm và nút Đăng nhập (Antigravity/landing-header-preview.html, #opt-1) -->
      <div class="hdr-info-stack">
        <div class="hdr-info-line" title="Giờ mở cửa">
          <i class="bi bi-clock-fill"></i>
          <span>07:30 – 20:00 (T2 – T7)</span>
        </div>
        <div class="hdr-info-line" title="Hotline">
          <i class="bi bi-telephone-fill"></i>
          <strong>028 3816 1673 - 137</strong>
        </div>
      </div>

      <a asp-controller="Account" asp-action="Login" class="pub-login-btn">
        Đăng nhập
      </a>
    </div>
  </header>

  <main class="pub-container">
    <partial name="_BookShowcase" model="Model" />
  </main>

  <footer class="pub-footer">
    <div class="pub-footer-main">
      <div class="pub-container">
        <h2 class="pub-footer-title">TRUNG TÂM THÔNG TIN - THƯ VIỆN ĐẠI HỌC CÔNG THƯƠNG TP.HCM</h2>
        <div class="pub-footer-row"><strong>Địa chỉ liên hệ:</strong> 140 Lê Trọng Tấn, Tân Phú, TP. Hồ Chí Minh, Việt Nam</div>
        <div class="pub-footer-row"><strong>Điện thoại:</strong> 028 3816 1673 - 137</div>
        <div class="pub-footer-row"><strong>Email:</strong> thuvien@huit.edu.vn</div>
        <div class="pub-footer-row">Hotline: 097 117 3837</div>
        <div class="pub-footer-dev">Phát triển bởi Phùng Tuấn Huy - Huỳnh Bá Thịnh</div>
      </div>
    </div>
    <div class="pub-footer-bottom">
      <div class="pub-container">&copy; @DateTime.Now.Year Thư viện Trường Đại học Công Thương TP.HCM.</div>
    </div>
  </footer>

  <script>
    document.getElementById("resetHome").addEventListener("click", e => {
      e.preventDefault();
      window.resetShowcaseFilters();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  </script>
</body>
</html>
