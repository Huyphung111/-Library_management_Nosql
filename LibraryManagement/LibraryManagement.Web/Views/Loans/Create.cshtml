@* UC07 Lập phiếu mượn: bước 2 nhập mã thẻ → bước 3 kiểm tra → bước 4–7 chọn sách, hạn trả → bước 8 lập phiếu *@
@model LibraryManagement.Web.ViewModels.Loans.CreateLoanVM
<div class="content-card">
    <form method="get" asp-action="Create" class="toolbar mb-0" novalidate id="cardForm" data-check-url="@Url.Action("CheckReader")">
        <input asp-for="CardNumber" class="form-control" placeholder="Nhập mã thẻ, ví dụ DG000001" autofocus />
        <button type="submit" class="btn btn-primary"><i class="bi bi-person-check"></i> Kiểm tra</button>
    </form>
    <span asp-validation-for="CardNumber" class="text-danger small"></span>
</div>

<div id="borrowerArea">
    <partial name="_Borrower" model="Model" />
</div>

@section Scripts {
    <script>
        // Bảng chọn sách: lọc theo tên / tác giả và đếm số cuốn đã chọn. Gọi lại sau mỗi lần AJAX thay nội dung.
        function initBookPicker() {
            const filter = document.getElementById("bookFilter");
            if (!filter) return;
            const rows = document.querySelectorAll("#bookTable tbody tr");
            const count = document.getElementById("pickedCount");
            filter.addEventListener("input", () => {
                const q = filter.value.trim().toLowerCase();
                rows.forEach(r => r.style.display = r.dataset.search.includes(q) ? "" : "none");
            });
            const update = () => count.textContent = document.querySelectorAll("#bookTable input:checked").length;
            document.querySelectorAll("#bookTable input").forEach(c => c.addEventListener("change", update));
            update();
        }

        // UC07 bước 2–3 bằng AJAX: gọi CheckReader, thay khối thông tin độc giả mà không tải lại trang.
        // Trình duyệt tắt JavaScript thì form vẫn gửi GET ?cardNumber= như bình thường.
        (function () {
            const form = document.getElementById("cardForm");
            const input = document.getElementById("CardNumber");
            const area = document.getElementById("borrowerArea");
            const fieldError = document.querySelector('[data-valmsg-for="CardNumber"]');
            let lastChecked = input.value.trim().toUpperCase();
            let pending = null;

            async function check(code) {
                if (pending) pending.abort();
                pending = new AbortController();
                area.classList.add("opacity-50");
                try {
                    const res = await fetch(form.dataset.checkUrl + "?cardNumber=" + encodeURIComponent(code), {
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        signal: pending.signal
                    });
                    if (!res.ok) throw new Error(res.status);
                    area.innerHTML = await res.text();
                    if (fieldError) fieldError.textContent = "";
                    lastChecked = code;
                    history.replaceState(null, "", "?cardNumber=" + encodeURIComponent(code));
                    initBookPicker();
                } catch (e) {
                    if (e.name !== "AbortError") form.submit();   // lỗi mạng: quay về cách tải lại trang
                } finally {
                    area.classList.remove("opacity-50");
                }
            }

            form.addEventListener("submit", e => {
                e.preventDefault();
                const code = input.value.trim().toUpperCase();
                if (code) check(code);
            });
            // Gõ đủ mã thẻ dạng DG + 6 số thì tự kiểm tra
            input.addEventListener("input", () => {
                const code = input.value.trim().toUpperCase();
                if (/^DG\d{6}$/.test(code) && code !== lastChecked) check(code);
            });
            initBookPicker();
        })();
    </script>
}
