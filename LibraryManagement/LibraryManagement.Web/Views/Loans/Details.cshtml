@* Chi tiết phiếu mượn: dùng sau UC07, từ UC06 (hồ sơ độc giả) và UC11 (Tìm kiếm phiếu mượn) *@
@model Loan

@section PageActions {
    @if (Model.Status == LoanStatus.Borrowing)
    {
        <a asp-action="Return" asp-route-keyword="@Model.LoanCode" class="btn btn-primary"><i class="bi bi-journal-arrow-down"></i> Nhận trả</a>
        <a asp-controller="Renewals" asp-action="Index" asp-route-loanCode="@Model.LoanCode" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Gia hạn tại quầy</a>
    }
    <a asp-controller="Readers" asp-action="Details" asp-route-id="@Model.Reader.ReaderId" class="btn btn-outline-secondary"><i class="bi bi-person"></i> Hồ sơ độc giả</a>
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="content-card h-100">
            <h2>Thông tin phiếu</h2>
            <dl class="info-list">
                <dt>Mã phiếu</dt><dd class="fw-semibold">@Model.LoanCode</dd>
                <dt>Độc giả</dt><dd>@Model.Reader.FullName (@Model.Reader.CardNumber)</dd>
                <dt>Ngày mượn</dt><dd>@Model.BorrowDate.ToVnDateText()</dd>
                <dt>Hạn trả</dt><dd class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")">@Model.DueDate.ToVnDateText()</dd>
                <dt>Trạng thái</dt>
                <dd>
                    @if (Model.IsOverdue)
                    {
                        <span class="badge status-overdue">Quá hạn @Model.OverdueDays ngày</span>
                    }
                    else
                    {
                        <span class="badge status-@Model.Status.ToString().ToLower()">@Model.Status.ToVn()</span>
                    }
                </dd>
                <dt>Số lần gia hạn</dt><dd>@Model.RenewalCount</dd>
                <dt>Tổng tiền phạt</dt><dd>@Model.TotalFine.ToMoney()</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="content-card h-100">
            <h2>Sách trong phiếu</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Tên sách</th><th>Ngày trả</th><th>Tình trạng</th><th class="text-end">Tiền phạt</th></tr></thead>
                    <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td>@it.Title</td>
                                <td>@(it.ReturnDate.HasValue ? it.ReturnDate.Value.ToVnDateText() : "Chưa trả")</td>
                                <td>
                                    @if (it.Condition.HasValue)
                                    {
                                        <span class="badge status-@it.Condition.Value.ToString().ToLower()">@it.Condition.Value.ToVn()</span>
                                    }
                                </td>
                                <td class="text-end">@(it.ReturnDate.HasValue ? it.Fine.ToMoney() : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.RenewalRequests.Count > 0)
{
    <div class="content-card mt-3">
        <h2>Yêu cầu gia hạn</h2>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Thời điểm</th><th>Nguồn</th><th>Trạng thái</th><th>Xử lý lúc</th><th>Lý do từ chối</th></tr></thead>
                <tbody>
                    @foreach (var rq in Model.RenewalRequests.OrderByDescending(x => x.RequestedAt))
                    {
                        <tr>
                            <td>@rq.RequestedAt.ToVnDateTimeText()</td>
                            <td>@rq.Source.ToVn()</td>
                            <td><span class="badge status-@rq.Status.ToString().ToLower()">@rq.Status.ToVn()</span></td>
                            <td>@(rq.ProcessedAt.HasValue ? rq.ProcessedAt.Value.ToVnDateTimeText() : "—")</td>
                            <td>@(rq.RejectReason ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
