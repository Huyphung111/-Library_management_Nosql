@model LibraryManagement.Web.ViewModels.Reports.FinesReportVM
@using LibraryManagement.Web.Services
@{
    ViewData["Title"] = "Thống kê thu tiền phạt";
}

<div class="content-card">
    @* Bộ lọc khoảng thời gian *@
    <form method="get" class="row g-2 align-items-center mb-4">
        <div class="col-md-5 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-white small">Từ ngày</span>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                <span class="input-group-text bg-white small">Đến ngày</span>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-filter me-1"></i>Lọc báo cáo
            </button>
            @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
            {
                <a asp-action="Fines" class="btn btn-outline-secondary ms-1">
                    <i class="bi bi-x-lg me-1"></i>Xóa lọc
                </a>
            }
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.ErrorMessage
        </div>
    }

    @* Thẻ tổng tiền phạt thu được *@
    <div class="stat-card border-0 bg-light p-3 rounded-3 d-flex align-items-center mb-4">
        <div class="stat-icon danger me-3">
            <i class="bi bi-cash-coin fs-2"></i>
        </div>
        <div>
            <div class="stat-value text-danger fs-3 fw-bold">@Model.TotalFines.ToString("#,##0") đ</div>
            <div class="stat-label text-muted small">Tổng số tiền phạt đã thu trong khoảng thời gian này</div>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state py-5">
            <i class="bi bi-shield-check text-success" style="font-size: 2.5rem;"></i>
            <p class="fs-6 text-muted mt-2 mb-0">Không có khoản thu tiền phạt nào trong khoảng thời gian này.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 45px;">#</th>
                        <th style="width: 120px;">Mã phiếu</th>
                        <th>Độc giả</th>
                        <th>Cuốn sách</th>
                        <th style="width: 130px;">Ngày trả</th>
                        <th style="width: 160px;">Loại vi phạm</th>
                        <th style="width: 140px;" class="text-end">Tiền phạt</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td class="text-muted">@(i + 1)</td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace fs-6">@item.LoanCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.ReaderName</div>
                                <div class="small text-muted">@item.CardNumber</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.BookTitle</div>
                            </td>
                            <td>@DateHelper.ToVnDate(item.ReturnDate).ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Condition == BookCondition.Lost)
                                {
                                    <span class="badge status-lost"><i class="bi bi-x-octagon me-1"></i>Làm mất sách</span>
                                }
                                else if (item.Condition == BookCondition.Damaged)
                                {
                                    <span class="badge status-damaged"><i class="bi bi-exclamation-diamond me-1"></i>Hư hỏng sách</span>
                                }
                                else
                                {
                                    <span class="badge status-overdue"><i class="bi bi-clock-history me-1"></i>Trễ hạn trả sách</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @item.FineAmount.ToString("#,##0") đ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
