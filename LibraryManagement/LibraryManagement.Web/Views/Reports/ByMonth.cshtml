@model LibraryManagement.Web.ViewModels.Reports.BorrowByMonthReportVM
@using System.Text.Json
@{
    ViewData["Title"] = "Thống kê lượt mượn theo tháng";
    var monthsJson = JsonSerializer.Serialize(Model.Months.Select(m => m.MonthName));
    var loanCountsJson = JsonSerializer.Serialize(Model.Months.Select(m => m.LoanCount));
    var bookCountsJson = JsonSerializer.Serialize(Model.Months.Select(m => m.BookCount));
}

<div class="content-card">
    @* Chọn năm thống kê *@
    <form method="get" class="row g-2 align-items-center mb-4">
        <div class="col-auto">
            <label class="col-form-label fw-semibold">Chọn năm:</label>
        </div>
        <div class="col-auto">
            <select name="year" class="form-select" onchange="this.form.submit()">
                @foreach (var y in Model.AvailableYears)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">Năm @y</option>
                }
            </select>
        </div>
    </form>

    @* Thống kê tổng số *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="stat-card border-0 bg-light p-3 rounded-3 d-flex align-items-center">
                <div class="stat-icon primary me-3">
                    <i class="bi bi-receipt fs-2"></i>
                </div>
                <div>
                    <div class="stat-value text-primary fs-3 fw-bold">@Model.TotalLoansInYear</div>
                    <div class="stat-label text-muted small">Tổng số phiếu mượn trong năm @Model.SelectedYear</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="stat-card border-0 bg-light p-3 rounded-3 d-flex align-items-center">
                <div class="stat-icon success me-3">
                    <i class="bi bi-book fs-2"></i>
                </div>
                <div>
                    <div class="stat-value text-success fs-3 fw-bold">@Model.TotalBooksInYear</div>
                    <div class="stat-label text-muted small">Tổng số cuốn sách được mượn</div>
                </div>
            </div>
        </div>
    </div>

    @* Khung biểu đồ Chart.js *@
    <div class="card border rounded-3 p-3 mb-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-graph-up me-2 text-primary"></i>Biểu đồ xu hướng mượn sách năm @Model.SelectedYear
        </h5>
        <div style="height: 320px; position: relative;">
            <canvas id="monthlyChart"></canvas>
        </div>
    </div>

    @* Bảng số liệu chi tiết 12 tháng *@
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 150px;">Tháng</th>
                    <th class="text-center">Số lượt mượn (phiếu)</th>
                    <th class="text-center">Số cuốn sách mượn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Months)
                {
                    <tr>
                        <td class="fw-semibold">@m.MonthName</td>
                        <td class="text-center font-monospace">@m.LoanCount</td>
                        <td class="text-center font-monospace">@m.BookCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById("monthlyChart").getContext("2d");
            const labels = @Html.Raw(monthsJson);
            const loanCounts = @Html.Raw(loanCountsJson);
            const bookCounts = @Html.Raw(bookCountsJson);

            new Chart(ctx, {
                type: "line",
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: "Số lượt mượn (Phiếu)",
                            data: loanCounts,
                            borderColor: "#1e3a5f",
                            backgroundColor: "rgba(30, 58, 95, 0.1)",
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointRadius: 4,
                            pointBackgroundColor: "#1e3a5f"
                        },
                        {
                            label: "Số cuốn sách mượn",
                            data: bookCounts,
                            borderColor: "#c8963e",
                            backgroundColor: "rgba(200, 150, 62, 0.1)",
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointRadius: 4,
                            pointBackgroundColor: "#c8963e"
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: "top",
                            labels: {
                                font: { family: "system-ui", size: 13 }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        });
    </script>
}

