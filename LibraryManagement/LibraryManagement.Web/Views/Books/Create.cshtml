@model LibraryManagement.Web.ViewModels.Books.BookFormVM
@{
    ViewData["Title"] = "Thêm sách mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="content-card">
            <h2><i class="bi bi-book-half me-2 text-primary"></i>Thông tin sách mới</h2>

            <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Đắc Nhân Tâm, Nhà Giả Kim..." autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AuthorsString" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="AuthorsString" class="form-control" placeholder="Ví dụ: Dale Carnegie, Nguyễn Nhật Ánh (nhiều tác giả cách nhau dấu phẩy)" />
                    <span asp-validation-for="AuthorsString" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="Publisher" class="form-label"></label>
                        <input asp-for="Publisher" class="form-control" placeholder="NXB Trẻ, NXB Kim Đồng..." />
                        <span asp-validation-for="Publisher" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="PublishYear" class="form-label"></label>
                        <input asp-for="PublishYear" type="number" class="form-control" placeholder="Ví dụ: 2023" />
                        <span asp-validation-for="PublishYear" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="Ví dụ: 86000" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TotalQuantity" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="TotalQuantity" type="number" min="1" class="form-control" />
                        <span asp-validation-for="TotalQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Thể loại</label> <span class="text-danger">*</span>
                    <div class="border rounded p-3 bg-light" style="max-height: 160px; overflow-y: auto;">
                        @if (Model.CategoryOptions.Count == 0)
                        {
                            <span class="text-muted small">Chưa có thể loại nào. Vui lòng thêm thể loại trước.</span>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var cat in Model.CategoryOptions)
                                {
                                    <div class="col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@cat.Value" id="cat_@cat.Value"
                                                   @(Model.SelectedCategoryIds.Contains(cat.Value) ? "checked" : "") />
                                            <label class="form-check-label" for="cat_@cat.Value">@cat.Text</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <span asp-validation-for="SelectedCategoryIds" class="text-danger small"></span>
                </div>

                @* Ảnh bìa: lưu trong MongoDB GridFS (mục 7.5 thiết kế kỹ thuật) *@
                <div class="mb-4">
                    <label asp-for="CoverFile" class="form-label"></label>
                    <div class="d-flex gap-3 align-items-start">
                        <div class="cover-preview" id="coverPreviewBox">
                            @if (!string.IsNullOrEmpty(Model.CoverImageId))
                            {
                                <img id="coverPreview" src="/Covers/@Model.CoverImageId" alt="Ảnh bìa hiện tại" />
                            }
                            else
                            {
                                <img id="coverPreview" alt="Xem trước ảnh bìa" class="d-none" />
                                <i class="bi bi-image" id="coverPlaceholder"></i>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <input asp-for="CoverFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                            <div class="form-text">JPG, PNG hoặc WebP, tối đa 2 MB.</div>
                            <span asp-validation-for="CoverFile" class="text-danger small"></span>
                            
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Lưu sách
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xem trước ảnh bìa trước khi lưu
        (function () {
            const input = document.getElementById("CoverFile");
            const img = document.getElementById("coverPreview");
            const ph = document.getElementById("coverPlaceholder");
            if (!input || !img) return;
            input.addEventListener("change", () => {
                const f = input.files[0];
                if (!f) return;
                img.src = URL.createObjectURL(f);
                img.classList.remove("d-none");
                if (ph) ph.classList.add("d-none");
                const rm = document.getElementById("RemoveCover");
                if (rm) rm.checked = false;
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}

