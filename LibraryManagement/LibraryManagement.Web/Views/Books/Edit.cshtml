@model LibraryManagement.Web.ViewModels.Books.BookFormVM
@{
    ViewData["Title"] = "Chỉnh sửa sách";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="content-card">
            <h2><i class="bi bi-pencil-square me-2 text-primary"></i>Cập nhật thông tin sách</h2>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
                <input type="hidden" asp-for="CoverImageId" />
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AuthorsString" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="AuthorsString" class="form-control" />
                    <span asp-validation-for="AuthorsString" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="Publisher" class="form-label"></label>
                        <input asp-for="Publisher" class="form-control" />
                        <span asp-validation-for="Publisher" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="PublishYear" class="form-label"></label>
                        <input asp-for="PublishYear" type="number" class="form-control" />
                        <span asp-validation-for="PublishYear" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input asp-for="Price" type="number" step="1000" class="form-control" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TotalQuantity" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="TotalQuantity" type="number" min="1" class="form-control" />
                        <div class="form-text small text-muted">
                            Đang cho mượn: <strong>@Model.CurrentBorrowedQuantity cuốn</strong>. Tổng số cuốn không được nhỏ hơn con số này.
                        </div>
                        <span asp-validation-for="TotalQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Thể loại</label> <span class="text-danger">*</span>
                    <div class="border rounded p-3 bg-light" style="max-height: 160px; overflow-y: auto;">
                        <div class="row g-2">
                            @foreach (var cat in Model.CategoryOptions)
                            {
                                <div class="col-sm-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@cat.Value" id="edit_cat_@cat.Value"
                                               @(Model.SelectedCategoryIds.Contains(cat.Value) ? "checked" : "") />
                                        <label class="form-check-label" for="edit_cat_@cat.Value">@cat.Text</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <span asp-validation-for="SelectedCategoryIds" class="text-danger small"></span>
                </div>

                @* Ảnh bìa: lưu trong MongoDB GridFS (mục 7.5 thiết kế kỹ thuật) *@
                <div class="mb-4">
                    <label asp-for="CoverFile" class="form-label"></label>
                    <div class="d-flex gap-3 align-items-start">
                        <div class="cover-preview" id="coverPreviewBox">
                            @if (!string.IsNullOrEmpty(Model.CoverImageId))
                            {
                                <img id="coverPreview" src="/Covers/@Model.CoverImageId" alt="Ảnh bìa hiện tại" />
                            }
                            else
                            {
                                <img id="coverPreview" alt="Xem trước ảnh bìa" class="d-none" />
                                <i class="bi bi-image" id="coverPlaceholder"></i>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <input asp-for="CoverFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                            <div class="form-text">JPG, PNG hoặc WebP, tối đa 2 MB. Không chọn ảnh mới thì giữ ảnh cũ.</div>
                            <span asp-validation-for="CoverFile" class="text-danger small"></span>

                            <label asp-for="CoverUrl" class="form-label mt-3 mb-1"></label>
                            <input asp-for="CoverUrl" type="url" class="form-control" placeholder="https://..." />
                            <div class="form-text">Hệ thống tải ảnh về và lưu như ảnh upload. Chọn cả file lẫn đường dẫn thì ưu tiên file.</div>
                            <span asp-validation-for="CoverUrl" class="text-danger small"></span>
                            @if (!string.IsNullOrEmpty(Model.CoverImageId))
                            {
                                <div class="form-check mt-2">
                                    <input asp-for="RemoveCover" class="form-check-input" />
                                    <label asp-for="RemoveCover" class="form-check-label">Xóa ảnh bìa hiện tại</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xem trước ảnh bìa trước khi lưu
        (function () {
            const input = document.getElementById("CoverFile");
            const img = document.getElementById("coverPreview");
            const ph = document.getElementById("coverPlaceholder");
            if (!input || !img) return;
            input.addEventListener("change", () => {
                const f = input.files[0];
                if (!f) return;
                img.src = URL.createObjectURL(f);
                img.classList.remove("d-none");
                if (ph) ph.classList.add("d-none");
                const rm = document.getElementById("RemoveCover");
                if (rm) rm.checked = false;
            });

            // Dán đường dẫn ảnh: xem trước ngay (chỉ trình duyệt tải để xem, khi lưu server mới tải về GridFS)
            const url = document.getElementById("CoverUrl");
            if (url) url.addEventListener("change", () => {
                const v = url.value.trim();
                if (!/^https?:\/\//i.test(v) || (input.files && input.files.length)) return;
                img.src = v;
                img.classList.remove("d-none");
                if (ph) ph.classList.add("d-none");
                const rm = document.getElementById("RemoveCover");
                if (rm) rm.checked = false;
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const input = document.getElementById("Title");
            if (input) {
                setTimeout(function () {
                    input.focus();
                    const len = input.value.length;
                    input.setSelectionRange(len, len);
                }, 50);
            }
        });
    </script>
}

