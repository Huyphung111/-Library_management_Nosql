@model List<LibraryManagement.Web.ViewModels.Books.BookListVM>
@{
    ViewData["Title"] = "Tra cứu sách";
    var categories = ViewBag.Categories as List<SelectListItem> ?? new();
}

<div class="content-card">
    @* Thanh tìm kiếm & lọc thể loại: 1 hàng ngang, nút tìm kiếm gắn liền với ô nhập *@
    <form method="get" class="row g-2 align-items-center mb-3">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên sách hoặc tác giả..." />
                <button type="submit" class="btn btn-primary">
                    Tìm kiếm
                </button>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả thể loại --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Value" selected="@c.Selected">@c.Text</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.CategoryId))
        {
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Xóa lọc
                </a>
            </div>
        }
    </form>

    <div class="result-info">
        Tìm thấy <strong>@Model.Count</strong> cuốn sách
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <span>theo từ khóa "<em>@ViewBag.Search</em>"</span>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <p class="fs-5">Không tìm thấy cuốn sách nào phù hợp.</p>
            <p class="small text-muted">Vui lòng thử tìm với từ khóa khác hoặc bỏ lọc thể loại.</p>
        </div>
    }
    else
    {
        @* Lưới thẻ sách chuẩn style UC13 *@
        <div class="book-grid">
            @for (int i = 0; i < Model.Count; i++)
            {
                var book = Model[i];
                var isAlt = (i % 2 == 1);
                var isOutOfStock = (book.AvailableQuantity == 0);

                <div class="book-card">
                    <div class="book-cover @(isAlt ? "alt" : "")">
                        <i class="bi bi-book-half"></i>
                    </div>

                    <div class="book-body">
                        @if (book.CategoryNames.Count > 0)
                        {
                            <span class="cat-tag">@book.CategoryNames.First()</span>
                        }

                        <a asp-action="Details" asp-route-id="@book.Id" class="book-title text-decoration-none" title="@book.Title">
                            @book.Title
                        </a>

                        <div class="book-meta">
                            <div><i class="bi bi-person me-1"></i>@book.Authors</div>
                            <div><i class="bi bi-building me-1"></i>@book.Publisher @(book.PublishYear.HasValue ? $"({book.PublishYear})" : "")</div>
                        </div>

                        <div class="book-foot">
                            @if (!isOutOfStock)
                            {
                                <span class="stock in">
                                    <i class="bi bi-check-circle-fill me-1"></i>Còn @book.AvailableQuantity cuốn
                                </span>
                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                    Chi tiết
                                </a>
                            }
                            else
                            {
                                <span class="stock out">
                                    <i class="bi bi-x-circle-fill me-1"></i>Hết sách
                                </span>
                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">
                                    Đặt trước
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

