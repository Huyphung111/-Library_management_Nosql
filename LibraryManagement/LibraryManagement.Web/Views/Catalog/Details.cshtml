@model LibraryManagement.Web.ViewModels.Books.BookListVM
@{
    ViewData["Title"] = "Chi tiết sách: " + Model.Title;
    var isOutOfStock = (Model.AvailableQuantity == 0);
    var isFavorite = ViewData["IsFavorite"] as bool? == true;
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="content-card">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h2 class="mb-0"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin đầu sách</h2>
                <div class="d-flex gap-2" data-fav-scope>
                    @* Nút yêu thích: wwwroot/js/reader.js gửi POST /MyFavorites/Add hoặc /Remove, đổi biểu tượng tại chỗ *@
                    <button type="button" class="btn btn-sm btn-outline-danger" data-fav-toggle data-book-id="@Model.Id"
                            data-book-title="@Model.Title" aria-pressed="@(isFavorite ? "true" : "false")">
                        <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")" data-fav-icon></i>
                        <span data-label-on="Đã yêu thích" data-label-off="Thêm vào yêu thích">@(isFavorite ? "Đã yêu thích" : "Thêm vào yêu thích")</span>
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Về danh mục
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                @* Cột bìa sách *@
                <div class="col-md-4 text-center">
                    <div class="p-4 bg-light rounded border text-center shadow-sm">
                        @if (!string.IsNullOrEmpty(Model.CoverImageId))
                        {
                            <img src="/Covers/@Model.CoverImageId" alt="Bìa sách @Model.Title" class="cover-large" />
                        }
                        else
                        {
                            <i class="bi bi-book text-primary" style="font-size: 5rem;"></i>
                        }
                        <h5 class="mt-3 fw-bold text-primary">@Model.Title</h5>
                        <div class="text-muted small">@Model.Authors</div>

                        <div class="mt-3">
                            @if (!isOutOfStock)
                            {
                                <span class="text-success fw-semibold fs-6">
                                    Còn @Model.AvailableQuantity / @Model.TotalQuantity cuốn
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold fs-6">
                                    Tạm hết sách (0/@Model.TotalQuantity)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @* Cột thông tin chi tiết *@
                <div class="col-md-8">
                    <dl class="info-list">
                        <dt>Tên sách:</dt>
                        <dd class="fw-bold fs-5 text-primary">@Model.Title</dd>

                        <dt>Tác giả:</dt>
                        <dd>@Model.Authors</dd>

                        <dt>Thể loại:</dt>
                        <dd>@string.Join(", ", Model.CategoryNames)</dd>

                        <dt>Nhà xuất bản:</dt>
                        <dd>@Model.Publisher</dd>

                        <dt>Năm xuất bản:</dt>
                        <dd>@(Model.PublishYear.HasValue ? Model.PublishYear.ToString() : "Chưa cập nhật")</dd>

                        <dt>Giá bìa (đền bù):</dt>
                        <dd class="fw-semibold text-danger">@Model.Price.ToString("#,##0") VNĐ</dd>

                        <dt>Tình trạng kệ:</dt>
                        <dd>
                            @if (!isOutOfStock)
                            {
                                <span class="text-success fw-semibold">Đang có sẵn trên giá</span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold">Tất cả các cuốn đều đang được mượn</span>
                            }
                        </dd>
                    </dl>

                    <hr class="my-3" />

                    @* Hướng dẫn mượn sách hoặc nút Đặt trước sách (UC16 bước 1a) *@
                    @if (!isOutOfStock)
                    {
                        <a asp-controller="MyReservations" asp-action="Create" asp-route-bookId="@Model.Id" data-reserve class="btn btn-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-bookmark-plus me-1"></i>Đặt giữ cuốn sách này
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 flex-shrink-0"></i>
                                <div>
                                    <strong>Sách này hiện đã được mượn hết!</strong><br />
                                    Bạn có thể đăng ký đặt trước. Khi có độc giả khác trả sách về kho, thư viện sẽ liên hệ bạn đến nhận.
                                </div>
                            </div>
                        </div>

                        <a asp-controller="MyReservations" asp-action="Create" asp-route-bookId="@Model.Id" data-reserve class="btn btn-warning btn-lg w-100 shadow-sm">
                            Đăng ký đặt trước cuốn sách này
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

