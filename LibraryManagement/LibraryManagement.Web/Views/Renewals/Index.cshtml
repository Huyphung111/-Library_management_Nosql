@* UC09: bước 1a gia hạn tại quầy; bước 2–6 duyệt yêu cầu; 4a không đủ điều kiện chỉ từ chối được; 5a từ chối kèm lý do *@
@model LibraryManagement.Web.ViewModels.Loans.RenewalIndexVM

<div class="content-card">
    <h2><i class="bi bi-shop"></i> Gia hạn tại quầy</h2>
    <form method="get" asp-action="Index" class="toolbar mb-0">
        <input asp-for="LoanCode" class="form-control" placeholder="Nhập mã phiếu, ví dụ PM000001" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Kiểm tra</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.CounterNotice))
    {
        <div class="alert alert-warning mt-3 mb-0">@Model.CounterNotice</div>
    }

    @if (Model.Counter != null)
    {
        var c = Model.Counter;
        <div class="border rounded p-3 mt-3">
            <dl class="info-list">
                <dt>Phiếu</dt><dd class="fw-semibold">@c.LoanCode</dd>
                <dt>Độc giả</dt><dd>@c.ReaderName (@c.CardNumber)</dd>
                <dt>Sách chưa trả</dt><dd>@string.Join(", ", c.Titles)</dd>
                <dt>Hạn trả hiện tại</dt><dd>@c.DueDate.ToVnDateText()</dd>
                <dt>Hạn trả mới</dt><dd class="fw-semibold">@c.NewDueDate.ToVnDateText()</dd>
                <dt>Đã gia hạn</dt><dd>@c.RenewalCount / @c.MaxRenewals lần</dd>
            </dl>
            @if (c.PendingRequestedAt != null)
            {
                <p class="small text-muted mt-2 mb-0">Phiếu đang có yêu cầu gia hạn online chờ duyệt; gia hạn tại quầy sẽ duyệt luôn yêu cầu đó.</p>
            }
            @if (!c.Eligible)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <div class="fw-semibold mb-1">Không đủ điều kiện gia hạn</div>
                    <ul class="mb-0">
                        @foreach (var p in c.Problems)
                        {
                            <li>@p</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <form asp-action="RenewAtCounter" method="post" class="mt-3" onsubmit="return confirm('Gia hạn phiếu @c.LoanCode đến @c.NewDueDate.ToVnDateText()?');">
                    <input type="hidden" name="loanId" value="@c.LoanId" />
                    <input type="hidden" name="loanCode" value="@c.LoanCode" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-calendar-check"></i> Gia hạn tại quầy</button>
                </form>
            }
        </div>
    }
</div>

<div class="content-card">
    <h2>Yêu cầu gia hạn chờ duyệt</h2>
    @if (Model.Pending.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-inbox"></i><p>Không có yêu cầu gia hạn nào đang chờ duyệt.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="pendingTable">
                <thead>
                    <tr><th>Độc giả</th><th>Mã phiếu</th><th>Hạn trả hiện tại</th><th class="text-center">Đã gia hạn</th><th>Gửi lúc</th><th>Điều kiện</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Pending)
                    {
                        <tr>
                            <td>@r.ReaderName<div class="small text-muted">@r.CardNumber</div></td>
                            <td><a asp-controller="Loans" asp-action="Details" asp-route-id="@r.LoanId" class="fw-semibold">@r.LoanCode</a></td>
                            <td>@r.DueDate.ToVnDateText()<div class="small text-muted">→ @r.NewDueDate.ToVnDateText()</div></td>
                            <td class="text-center">@r.RenewalCount / @r.MaxRenewals</td>
                            <td>@(r.PendingRequestedAt?.ToVnDateTimeText())</td>
                            <td>
                                @if (r.Eligible)
                                {
                                    <span class="badge status-active">Đủ điều kiện</span>
                                }
                                else
                                {
                                    <ul class="small text-danger mb-0 ps-3">
                                        @foreach (var p in r.Problems)
                                        {
                                            <li>@p</li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td class="actions">
                                <form asp-action="Approve" method="post" onsubmit="return confirm('Duyệt gia hạn phiếu @r.LoanCode?');">
                                    <input type="hidden" name="loanId" value="@r.LoanId" />
                                    <button type="submit" class="btn btn-sm btn-primary" @(r.Eligible ? "" : "disabled") title="@(r.Eligible ? "" : "Không đủ điều kiện, chỉ từ chối được")">
                                        <i class="bi bi-check2"></i> Duyệt
                                    </button>
                                </form>
                                @* Mở hộp nhập lý do (modal #rejectModal bên dưới), thông tin phiếu truyền qua data-* *@
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal"
                                        data-loan-id="@r.LoanId" data-loan-code="@r.LoanCode" data-reader="@r.ReaderName">
                                    <i class="bi bi-x"></i> Từ chối
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Hộp từ chối gia hạn: nhập lý do rồi bấm Xác nhận *@
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                <input type="hidden" name="loanId" id="rejectLoanId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalTitle">Từ chối gia hạn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Phiếu <strong id="rejectLoanCode"></strong> của <strong id="rejectReader"></strong>.</p>
                    <label for="rejectReason" class="form-label">Lý do từ chối</label>
                    <input type="text" name="reason" id="rejectReason" class="form-control" required maxlength="200" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Điền thông tin phiếu vào hộp từ chối khi mở, xóa lý do cũ và đặt con trỏ vào ô nhập
        (function () {
            const modal = document.getElementById("rejectModal");
            modal.addEventListener("show.bs.modal", e => {
                const btn = e.relatedTarget;
                document.getElementById("rejectLoanId").value = btn.dataset.loanId;
                document.getElementById("rejectLoanCode").textContent = btn.dataset.loanCode;
                document.getElementById("rejectReader").textContent = btn.dataset.reader;
                document.getElementById("rejectReason").value = "";
            });
            modal.addEventListener("shown.bs.modal", () => document.getElementById("rejectReason").focus());
        })();
    </script>
}
